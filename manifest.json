{
  "manifest_version": 3,
  "name": "No Sports",
  "version": "1.4",
  "description": "Hides sports posts, links, and pages across the web.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "No Sports",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["words.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
